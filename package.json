{
  "name": "media-query-observer",
  "version": "1.0.4",
  "description": "Run a callback when a CSS media query starts or stops matching",
  "keywords": [
    "media-query",
    "matchMedia",
    "observer",
    "responsive-design"
  ],
  "homepage": "https://github.com/mellonis/media-query-observer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mellonis/media-query-observer.git"
  },
  "bugs": {
    "url": "https://github.com/mellonis/media-query-observer/issues"
  },
  "type": "main",
  "main": "dist/index.js",
  "module": "src/index.js",
  "scripts": {
    "build": "npm run lint && npm run test && rollup -c",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "Ruslan Gilmullin <mellonis@yandex.ru>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rollup": "^4.63.5"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "browserslist": [
    "ie 11",
    "edge >= 15",
    "firefox >= 6",
    "chrome >= 36",
    "safari >= 8",
    "opera >= 23"
  ]
}
